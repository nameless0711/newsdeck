PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
# true öffnet NEWSDECK auf 127.0.0.1 ohne Anmeldemaske mit dem vorhandenen Admin-Konto.
NEWSDECK_LOCAL_NO_LOGIN=false
# Für lokale Nutzung leer lassen; Docker verwendet PostgreSQL.
DATABASE_URL=
POSTGRES_PASSWORD=
WEB_PORT=3000
SQLITE_PATH=data/newsdeck.sqlite
ADMIN_EMAIL=admin@newsdeck.local
# Mindestens 14 Zeichen; npm run setup fragt interaktiv danach.
ADMIN_PASSWORD=
COOKIE_SECURE=false
# OpenAI-kompatible Schnittstelle, auch lokale Modelle (z.B. Ollama /v1)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Themenschwellen: 1 = niedrig, 2 = mittel, 3 = hoch (keine Wahrscheinlichkeiten)
TOPIC_RULE_THRESHOLD=2
TOPIC_AI_THRESHOLD=3
# Optional: offizielle Meta Business Discovery API (kein beliebiges Profil-Scraping)
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_IG_USER_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BRIEFING_TIMEZONE=Europe/Berlin
# Feste lokale RSSHub-Adresse; niemals von einer Quellen-URL übernommen.
RSSHUB_BASE_URL=http://127.0.0.1:1200
