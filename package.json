    "fast-xml-parser": "5.11.2",
    "helmet": "8.1.0",
    "lucide-react": "0.468.0",
    "nodemailer": "10.3.1",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.5",
    "@types/node": "24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "playwright": "1.64.1",
